@model ProjectsViewModel
@{
	ViewData["Title"] = "Projects";
}

@await Html.PartialAsync("Partials/Sections/_AddProjectModal", Model.AddProjectForm)
@await Html.PartialAsync("Partials/Sections/_EditProjectModal", Model.EditProjectForm)

<section id="projects">
	<header class="portal-layout-main-header">
		<h2>Projects</h2>
		<button type="button" data-modal="true" data-target="#addProjectModal" class="btn btn-blue btn-add"><i class="fa-solid fa-plus"></i>Add Project</button>
	</header>
</section>

<section class="filter-projects-menu">
	<button onclick="filterProjects('All')" class="filter-projects-link all">ALL [@Model.CountAllProjects]</button>
	<button onclick="filterProjects('Not started')" class="filter-projects-link not-started">NOT STARTED [@Model.CountNotStartedProjects]</button>
	<button onclick="filterProjects('Started')" class="filter-projects-link started">STARTED [@Model.CountStartedProjects]</button>
	<button onclick="filterProjects('Completed')" class="filter-projects-link completed">COMPLETED [@Model.CountCompletedProjects]</button>
</section>

<div id="project-container">

	@await Html.PartialAsync("Partials/Sections/_ProjectList", Model.Projects)
</div>

@section Scripts 
{
	<script src="~/js/projects.js"></script>
}