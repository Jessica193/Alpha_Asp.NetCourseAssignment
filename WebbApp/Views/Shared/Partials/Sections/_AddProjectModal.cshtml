@model AddProjectViewModel

<div id="addProjectModal" class="modal">
	<div class="modal-content">

		<div class="modal-header">
			<h3>Add Project</h3>
			<button type="button" class="btn-close" data-close="true"><i class="fa-solid fa-xmark"></i></button>
		</div>

		<form novalidate method="post" asp-action="Add" asp-controller="Projects" enctype="multipart/form-data" data-modal-form="true">

			<div class="image-previewer circle ">
				<img src="" class="image-preview" alt="project image" />
				<input asp-for="ProjectImage" type="file" class="d-none" accept="image/*" />
			</div>


			<div class="form-group">
				<label asp-for="ProjectName"></label>
				<div class="field-group">
					<input asp-for="ProjectName" />
					<span asp-validation-for="ProjectName"></span>
				</div>
			</div>

			<div class="form-group">
				<label asp-for="ClientId"></label>
				<select asp-for="ClientId" asp-items="Model.AvailableClients">
					<option disabled selected value="">-- Select client --</option>
				</select>
				<span asp-validation-for="ClientId"></span>
			</div>

			<div class="form-group">
				<label asp-for="Description"></label>
				<div class="field-group wysiwyg">
					<textarea asp-for="Description" id="addDescription"></textarea>
					<div id="add-project-wysiwyg-editor"></div>
					<div id="add-project-wysiwyg-toolbar">
						<span class="ql-formats">
							<button class="ql-bold"></button>
							<button class="ql-italic"></button>
							<button class="ql-underline"></button>
						</span>
						<span class="ql-formats">
							<button class="ql-align" value=""></button>
							<button class="ql-align" value="center"></button>
							<button class="ql-align" value="right"></button>
						</span>
						<span class="ql-formats">
							<button class="ql-list" value="bullet"></button>
							<button class="ql-list" value="ordered"></button>
						</span>
						<span class="ql-formats">
							<button class="ql-link"></button>
						</span>
					</div>
				</div>
			</div>

			<div class="form-group form-group-flex">
				<div class="form-group">
					<label asp-for="StartDate"></label>
					<div class="field-group">
						<input class="modal-date" asp-for="StartDate" type="date" placeholder="Enter start date" />
						<span asp-validation-for="StartDate"></span>
					</div>
				</div>

				<div class="form-group">
					<label asp-for="EndDate"></label>
					<div class="field-group">
						<input class="modal-date" asp-for="EndDate" type="date" placeholder="Enter end date" />
						<span asp-validation-for="EndDate"></span>
					</div>
				</div>
			</div>

			<div class="form-group">
				<label asp-for="MemberIds"></label>
				<select asp-for="MemberIds" asp-items="Model.AvailableMembers" multiple class="js-member-select">
					@foreach (var member in Model.AvailableMembers)
					{
						<option value="@member.Value" data-image="/@member.ImagePath">@member.Text</option>
					}

					<option disabled selected value="">-- Select member --</option>
				</select>
				<span asp-validation-for="MemberIds"></span>
			</div>

			<div class="form-group">
				<label asp-for="Budget"></label>
				<div class="field-group">
					<div class="budget-input-wrapper">
						<input asp-for="Budget" />
						<span class="currency-symbol">$</span>
					</div>
					<span asp-validation-for="Budget"></span>
				</div>
			</div>

			<div class="form-group">
				<label asp-for="StatusId"></label>
				<select asp-for="StatusId" asp-items="Model.AvailableStatuses">
					<option disabled selected value="">-- Select status --</option>
				</select>
				<span asp-validation-for="StatusId"></span>
			</div>

			<button class="btn btn-blue btn-submit" type="submit">Create</button>
		</form>

	</div>
</div>

@await Html.PartialAsync("Partials/Javascripts/_ValidationScriptsPartial")

