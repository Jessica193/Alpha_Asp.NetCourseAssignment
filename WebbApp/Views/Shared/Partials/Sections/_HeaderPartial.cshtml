@inject UserManager<MemberEntity> _userManager
@inject SignInManager<MemberEntity> _signInManager
@{
	var user = await _userManager.GetUserAsync(User);
	var fullName = $"{user?.FirstName} {user?.LastName}" ?? "Användare";
	var profileImage = string.IsNullOrWhiteSpace(user?.ImagePath)
	? "/Images/Avatars/Avatar1.svg"
	: "/" + user.ImagePath;

	var provider = User?.FindFirstValue(ClaimTypes.AuthenticationMethod);
	if (string.IsNullOrEmpty(provider))
		provider = "Local Identity";

	var email = User?.FindFirstValue(ClaimTypes.Email);

	
}


<form class="search-form" method="get" asp-controller="" asp-action="" novalidate  >
	<i class="fa-solid fa-magnifying-glass"></i>
	<input type="search" class="form-search-input" placeholder="Search anything..." />
</form>

<div id="notification-container">
	<button type="button" data-type="dropdown" data-target="#notification-dropdown" class="btn btn-notification">
		<i class="dot dot-red fa-solid fa-circle"></i>
		<i class="fa-duotone fa-solid fa-bell" style="--fa-primary-opacity: 0.4; --fa-secondary-opacity: 1;"></i>
	</button>
	<div id="notification-dropdown" class="dropdown">
		<div class="dropdown-header">
			<h4>Notifications</h4>
			<div class="badge badge-red">99+</div>
		</div>
		<div class="divider notification-divider"></div>
		<div class="notifications">
			<div class="notification" data-notification-type="user">
				<div class="project-image">
					<img src="/Images/ProjectImage.svg" alt="notification image" />
				</div>
				<span class="message">Jessica Eriksson</span>
				<span class="time">10 min ago</span>
				<button type="button" class="btn-close" data-close="true"><i class="fa-solid fa-xmark"></i></button>
			</div>
			<div class="notification" data-notification-type="user">
				<div class="project-image">
					<img src="/Images/ProjectImage.svg" alt="notification image" />
				</div>
				<span class="message">Jessica Eriksson</span>
				<span class="time">10 min ago</span>
				<button type="button" class="btn-close" data-close="true"><i class="fa-solid fa-xmark"></i></button>
			</div>
		</div>
	</div>
</div>

<div id="account-container">
	<button type="button" data-type="dropdown" data-target="#account-dropdown" class="btn btn-account">
		<img src="/Images/Avatars/Avatar1.svg" alt="profile picture" />
	</button>

	<div id="account-dropdown" class="dropdown">
		<div class="dropdown-header">
			<div class="account-name">
				<img src=@profileImage alt="profile picture" />
				<span>@fullName</span>
			</div>
		</div>
		<div class="dropdown-body">
			<nav class="dropdown-options">
				<div class="dropdown-option" >
					<label for="darkModeToggle" class="switch-label">
						<i class="fa-duotone fa-solid fa-cog"></i>
						<span>Dark Mode</span>
					</label>
					<label  class="switch">
						<input type="checkbox" id="darkmode-switch" data-type="toggle" data-func="darkmode" />
						<span class="slider"></span>
					</label>					
				</div>
			</nav>
			<div class="divider account-divider"></div>
			<nav class="dropdown-actions">
				<a class="dropdown-action" asp-action="SignOut" asp-controller="Auth">
					<i class="fa-duotone fa-solid fa-right-from-bracket"></i>
					<span>Logout</span>
				</a>
			</nav>
		</div>
	</div>
</div>


