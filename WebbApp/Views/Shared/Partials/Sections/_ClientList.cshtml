@model IEnumerable<Client>



<div class="client-list surface">
	<table>
		<thead>
			<tr>
				<th class="client-check"><input type="checkbox" /></th>
				<th class="client-info">Client name</th>
				<th class="client-location">Location</th>
				<th class="client-phone">Phone</th>
				<th class="client-date">Date</th>
				<th class="client-status">Status</th>
				<th class="client-actions"></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var client in Model)
			{
				<tr>
					<td class="client-check"><input type="checkbox" /></td>
					<td class="client-info">
						<img class="client-image" src="~/@(client.ImagePath ?? "Images/Avatars/Avatar1.svg")" alt="profile image" />
						<div class="client-name">@client.ClientName</div>
						<div class="client-email">@client.Email</div>
					</td>
					<td class="client-location">@client.Location</td>
					<td class="client-phone">@client.Phone</td>
					<td class="client-date">@DateTime.Now.ToString("yy-MM-dd")</td>  <!-- Byt ut till "CreatedDate" -->
					<td class="client-status">
						<div class="badge bg-success">
							active
						</div>
					</td>
					<td class="client-actions">
						<div id="client-actions-container">
							<div class="btn-edit-div">
								<button class="btn-edit" type="button" data-type="dropdown" data-target="#client-dropdown-@client.Id">
									<i class="fa-solid fa-ellipsis"></i>
								</button>
							</div>
							<div id="client-dropdown-@client.Id" class="dropdown">
								<div class="dropdown-body">
									<nav class="dropdown-actions">
										<a class="dropdown-action" data-modal="true" data-client-id="@client.Id" data-target="#editClientModal">
											<i class="fa-duotone fa-solid fa-pen-line"></i>
											<span>Edit</span>
										</a>
									</nav>
									<div class="divider member-divider"></div>
									<nav class="dropdown-actions">
										<form asp-action="Delete" asp-controller="Clients" asp-route-id="@client.Id" method="post" novalidate>
											<button type="submit" class="dropdown-action">
												<i class="fa-duotone fa-solid fa-trash" style="--fa-primary-color: #e52424; --fa-secondary-color: #e52424;"></i>
												<span class="delete-span">Delete Client</span>
											</button>
										</form>
									</nav>
								</div>
							</div>
						</div>

					</td>
				</tr>
			}
		</tbody>
	</table>
</div>


