@model IEnumerable<Project>



@if (Model != null && Model.Any())
{
    <section id="projectList">

        @foreach (var project in Model)
        {
                <div class="project-card surface" data-project-id="@project.Id">
                    <div class="project-card-top">
                        <img src="~/@(project.ImagePath ?? "Images/ProjectImage.svg")" alt="project image">
                        <div class="project-card-header-info">
                            <h6>@project.ProjectName</h6>
                            <p>@project.Client.ClientName</p>
                        </div>

                        <div id="project-actions-container">
                            <button class="btn-edit" type="button" data-type="dropdown" data-target="#project-dropdown-@project.Id">
                                <i class="fa-solid fa-ellipsis"></i>
                            </button>
                        <div id="project-dropdown-@project.Id" class="dropdown">
                            <div class="dropdown-body">
                                    <nav class="dropdown-actions">
                                        <a class="dropdown-action" data-modal="true" data-project-id="@project.Id" data-target="#editProjectModal">
                                            <i class="fa-duotone fa-solid fa-pen-line"></i>
                                            <span>Edit</span>
                                        </a>
                                    </nav>
                                    <nav class="dropdown-actions">
                                        <a class="dropdown-action">
                                            <i class="fa-duotone fa-solid fa-user-plus"></i>
                                            <span>Add Member</span>
                                        </a>
                                    </nav>
                                    <div class="divider dropdown-divider"></div>
                                    <nav class="dropdown-actions">
                                    <form asp-action="Delete" asp-controller="Projects" asp-route-id="@project.Id" method="post" novalidate>
                                        <button type="submit" class="dropdown-action">
                                            <i class="fa-duotone fa-solid fa-trash" style="--fa-primary-color: #e52424; --fa-secondary-color: #e52424;"></i>
                                            <span class="delete-span">Delete Project</span>
                                        </button>
                                    </form>
                                    </nav>
                                </div>
                            </div>
                        </div>

                    </div>
                <p class="project-card-description">@project.Description</p>
                <div class="project-card-bottom">

                    @{
                        var daysLeft = (project.EndDate.Date - DateTime.Today).Days;
                        string timeLeftText;

                        if (daysLeft < 0)
                        {
                            timeLeftText = "Project ended";
                        }
                        else if (daysLeft == 0)
                        {
                            timeLeftText = "Last day!";
                        }
                        else if (daysLeft == 1)
                        {
                            timeLeftText = "1 day left";
                        }
                        else if (daysLeft < 7)
                        {
                            timeLeftText = $"{daysLeft} days left";
                        }
                        else if (daysLeft < 30)
                        {
                            var weeks = daysLeft / 7;
                            timeLeftText = weeks == 1 ? "1 week left" : $"{weeks} weeks left";
                        }
                        else
                        {
                            var months = daysLeft / 30;
                            timeLeftText = months == 1 ? "1 month left" : $"{months} months left";
                        }
                    }

                    <div class="time-left">
                        <i class="fa-solid fa-clock"></i>
                        <p>@timeLeftText</p>
                    </div>

                    <div class="project-card-member-list">
                        @foreach (var member in project.Members)
                        {
                            var imagePath = !string.IsNullOrEmpty(member.ImagePath)
                            ? member.ImagePath
                            : "Images/Avatars/Avatar1.svg";

                            <img src="~/@imagePath" alt="@member.FirstName @member.LastName" />
                        }
                    </div>
                </div>
            </div>
        }

    </section>
}
else
{
    <p>No projects available.</p>
}








