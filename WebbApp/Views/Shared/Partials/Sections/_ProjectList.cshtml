@model IEnumerable<Project>



@if (Model != null && Model.Any())
{
    <section id="projectList">

        @foreach (var project in Model)
        {
            <div class="project-card surface">
                <div class="project-card-top">
                    <img src="~/@(project.ImagePath ?? "Images/ProjectImage.svg")" alt="project image">
                    <div class="project-card-header-info">
                        <h6>@project.ProjectName</h6>
                        <p>@project.Client.ClientName</p>
                    </div>
                    <button class="btn-edit" type="button" data-modal="true" data-target="#editProjectModal" data-project-id="@project.Id">
                        <i class="fa-solid fa-ellipsis"></i>
                    </button>    
                </div>




                <div id="account-dropdown" class="dropdown">
                    <div class="dropdown-header">
                        <div class="account-name">
                            <img src="~/Images/ProjectImage.svg" alt="profile picture" />
                            <span>Jessica Eriksson</span>
                        </div>
                    </div>
                    <div class="dropdown-body">
                        <nav class="dropdown-options">
                            <div class="dropdown-option">
                                <label for="darkModeToggle" class="switch-label">
                                    <i class="fa-duotone fa-solid fa-cog"></i>
                                    <span>Dark Mode</span>
                                </label>
                                <label class="switch">
                                    <input type="checkbox" id="darkModeToggle" data-type="toggle" data-func="darkmode" />
                                    <span class="slider"></span>
                                </label>
                            </div>
                        </nav>
                        <div class="divider account-divider"></div>
                        <nav class="dropdown-actions">
                            <a class="dropdown-action" asp-action="SignOut" asp-controller="Auth">
                                <i class="fa-duotone fa-solid fa-right-from-bracket"></i>
                                <span>Logout</span>
                            </a>
                        </nav>
                    </div>
                </div>





                <p class="project-card-description">@project.Description</p>

                <div class="project-card-bottom">

                    @{
                        var daysLeft = (project.EndDate.Date - DateTime.Today).Days;
                        string timeLeftText;

                        if (daysLeft < 0)
                        {
                            timeLeftText = "Project ended";
                        }
                        else if (daysLeft == 0)
                        {
                            timeLeftText = "Last day!";
                        }
                        else if (daysLeft == 1)
                        {
                            timeLeftText = "1 day left";
                        }
                        else if (daysLeft < 7)
                        {
                            timeLeftText = $"{daysLeft} days left";
                        }
                        else if (daysLeft < 30)
                        {
                            var weeks = daysLeft / 7;
                            timeLeftText = weeks == 1 ? "1 week left" : $"{weeks} weeks left";
                        }
                        else
                        {
                            var months = daysLeft / 30;
                            timeLeftText = months == 1 ? "1 month left" : $"{months} months left";
                        }
                    }

                    <div class="time-left">
                        <i class="fa-solid fa-clock"></i>
                        <p>@timeLeftText</p>
                    </div>

                    <div class="project-card-member-list">
                        @foreach (var member in project.Members)
                        {
                            var imagePath = !string.IsNullOrEmpty(member.ImagePath)
                            ? member.ImagePath
                            : "Images/Avatars/Avatar1.svg";

                            <img src="~/@imagePath" alt="@member.FirstName @member.LastName" />
                        }
                    </div>
                </div>
            </div>
        }

    </section>
}
else
{
    <p>No projects available.</p>
}


